# macOS が exFAT に作る隠しファイル
._*
.DS_Store

# ビルドで作るもの (作り直せる)
# web/ は frontend/ のビルド結果 (ブラウザに配るファイル)。Go の実行ファイルに埋め込む
/web/
/qr-server
/qr-server.exe
# mac-docker/dev.sh が作る実行ファイル
/build/

# HTTPS の証明書と秘密鍵 (起動した時に自動で作るもの・持ってきたもの。秘密鍵は人に渡さない)
qr-server.crt
qr-server.key
*.pem

# 画面の依存 (npm ci で入る)
frontend/node_modules/
# mac-docker/dev.sh が、依存を入れ直すかどうかの目印にする
frontend/.installed
